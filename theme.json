{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "page",
					"name": "ページの地",
					"color": "#f3f3f3"
				},
				{
					"slug": "base",
					"name": "背景（箱）",
					"color": "#ffffff"
				},
				{
					"slug": "contrast",
					"name": "文字",
					"color": "#333333"
				},
				{
					"slug": "sub",
					"name": "補助の文字",
					"color": "#999999"
				},
				{
					"slug": "line",
					"name": "線",
					"color": "#e3e3e3"
				},
				{
					"slug": "soft",
					"name": "うすい地",
					"color": "#f6f6f6"
				},
				{
					"slug": "dark",
					"name": "濃い色（ラベル・カテゴリー）",
					"color": "#333333"
				},
				{
					"slug": "title",
					"name": "記事タイトル",
					"color": "#666666"
				},
				{
					"slug": "primary",
					"name": "見出しの線",
					"color": "#5064ad"
				},
				{
					"slug": "h2-bg",
					"name": "大見出しの地",
					"color": "#f4f4f4"
				},
				{
					"slug": "check",
					"name": "小見出しの印",
					"color": "#2f4a8f"
				},
				{
					"slug": "link",
					"name": "リンク",
					"color": "#3d79c4"
				},
				{
					"slug": "link-hover",
					"name": "リンク（ホバー）",
					"color": "#2a5c9c"
				},
				{
					"slug": "accent",
					"name": "アクセント",
					"color": "#b8933a"
				},
				{
					"slug": "marker",
					"name": "マーカー",
					"color": "#ffe58a"
				},
				{
					"slug": "footer",
					"name": "フッター",
					"color": "#222222"
				},
				{
					"slug": "footer-text",
					"name": "フッターの文字",
					"color": "#c9ced6"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "ゴシック",
					"fontFamily": "\"Hiragino Kaku Gothic ProN\", \"Hiragino Sans\", \"Noto Sans JP\", \"Yu Gothic Medium\", \"Yu Gothic\", Meiryo, sans-serif"
				},
				{
					"slug": "mono",
					"name": "等幅",
					"fontFamily": "\"SFMono-Regular\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "極小",
					"size": "12px"
				},
				{
					"slug": "small",
					"name": "小",
					"size": "14px"
				},
				{
					"slug": "medium",
					"name": "標準",
					"size": "16px"
				},
				{
					"slug": "large",
					"name": "大",
					"size": "21px"
				},
				{
					"slug": "x-large",
					"name": "特大",
					"size": "28px"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw"
			]
		},
		"custom": {
			"radius": "3px",
			"heading-radius": "0px",
			"shadow": "0 1px 3px rgb(0 0 0 / 8%)",
			"site-width": "1200px",
			"side-width": "300px",
			"gap": "48px",
			"article-size": "18px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--page)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.9"
		},
		"spacing": {
			"blockGap": "24px",
			"padding": {
				"top": "0px",
				"right": "0px",
				"bottom": "0px",
				"left": "0px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--link)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--link-hover)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.5"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--dark)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": {
					"radius": "4px"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "ヘッダー",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "フッター",
			"area": "footer"
		},
		{
			"name": "sidebar",
			"title": "サイドバー",
			"area": "uncategorized"
		}
	]
}