<?xml version="1.0"?>
<ruleset name="snowweb">
	<description>snowweb のコーディング規約チェック</description>
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="snowweb"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="snowweb"/>
			</property>
		</properties>
	</rule>
	<!-- 日本語のコメント（「。」で終わる・大文字がない）を許可 -->
	<rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
		<severity>0</severity>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.ParamCommentFullStop">
		<severity>0</severity>
	</rule>
	<rule ref="Generic.Commenting.DocComment.ShortNotCapital">
		<severity>0</severity>
	</rule>
</ruleset>
